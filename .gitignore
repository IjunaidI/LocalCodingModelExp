# Track source by default (specs, scripts, datasets, docs, READMEs).
# Ignore only regenerable artifacts, environments, and large model caches.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Virtual environments ---
.venv/
venv/
**/venv/
.env
**/.env

# --- macOS ---
.DS_Store
**/.DS_Store

# --- Model weights & caches (regenerable; ~GBs; downloaded on first run) ---
# Matches the real ./model_cache and the per-experiment symlinks into it.
model_cache
**/model_cache

# --- Generated harness intermediates (regenerated by the reference/solve scripts) ---
inputs_only*.csv
_inputs_only*.csv
_tmp_inputs*.csv
_dbg*.csv

# --- Sweet-spot experiment: keep specs, solutions and results.{md,json}; drop run logs ---
experiments/sweet-spot/*/outputs/run_*.log

# --- 30-rule experiment: drop regenerable live-run logs (result captured in the README) ---
experiments/30-rule/run_*.log
experiments/30-rule/**/run_*.log

# --- Subproject: finetune-with-mlx (keep source, drop heavy/regenerable outputs) ---
finetune-with-mlx/adapters/
finetune-with-mlx/adapters_v*/
finetune-with-mlx/.deepeval/
finetune-with-mlx/.deepeval_telemetry.txt
finetune-with-mlx/.claude/

# --- Generated report intermediate (PDF + build_report.py are tracked) ---
docs/*.html
